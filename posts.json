---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": "{{ post.title | escape }}",
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "category": "{{ post.category | default: '' }}",
    "url": "{{ post.url | relative_url }}"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
